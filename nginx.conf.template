# nginx 配置模板：构建进镜像 /etc/nginx/templates/，官方 nginx 镜像启动时
# 用 envsubst 把 ${BACKEND_HOST} 替换成容器环境变量（只替换已定义的变量，
# $host 等 nginx 内置变量不受影响）。
# BACKEND_HOST 由部署时的 docker-compose 传入（默认 host.docker.internal = 宿主机）。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # gzip 压缩
    gzip on;
    gzip_min_length 1k;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # 带 hash 的静态资源长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 后端 API 反向代理（BACKEND_HOST 是独立部署的后端服务地址）
    # 不带路径的 proxy_pass 保留 /api 前缀，正好对上后端的全局前缀
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 健康检查（后端 /health 不带 /api 前缀）
    location = /health {
        proxy_pass http://${BACKEND_HOST}:3000;
        access_log off;
    }

    # SPA history 路由：所有前端路径都回退到 index.html（解决刷新 404）
    location / {
        try_files $uri $uri/ /index.html;
    }
}
